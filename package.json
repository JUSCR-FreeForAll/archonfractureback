{
  "name": "juscr-mesh",
  "version": "0.1.0",
  "description": "JUSCR Open Resonance Mesh and Consent-Ledger runtime",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "psql $DATABASE_URL -f db/schema.sql && psql $DATABASE_URL -f db/migrations/002_time_engine.sql",
    "lint": "eslint .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit --rootDir .",
    "test:all": "bash ./scripts/run-all-tests.sh",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:vps-ssh": "bash scripts/test-vps-ssh.sh",
    "health:vps": "bash scripts/check-vps-health.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.2.6",
    "prisma": "^6.19.0",
    "typescript-eslint": "^8.46.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
